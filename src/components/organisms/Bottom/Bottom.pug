mixin Bottom()
    .o-bottom
        .o-bottom__picture 
            .o-bottom__vector-top 
                img(src="/img/vectors/bottom-top.svg")
            img(src="/img/bottom.webp")
            .o-bottom__vector-btm 
                img(src="/img/vectors/bottom-btm.svg")

        .w-container
            .o-bottom__content
                +AnimatedShow
                    +Title('2').o-bottom__title Если у вас остались вопросы, <br>обращайтесь к нам
                +AnimatedShow
                    .o-bottom__contacts
                        span <a href="tel:+79522402152">+7 (952) 240-21-52</a>, Георгий
                        span <a href="tel:+79092955403">+7 (909) 295-54-03</a>, Юлия

        
