mixin About
    .o-about.w-container
        .o-about__content
            .o-about__block
                +AnimatedShow.o-about__quote
                    +Title('2').o-about__quote-title Да будет милость Твоя, Господи, над нами, как мы уповаем на Тебя
                    +Title('3').o-about__quote-desc Псалом 32,22

                +AnimatedShow.o-about__invite
                    +Title('2').o-about__invite-text Дорогие родные и друзья!
                    +Title('3').o-about__invite-desc Приглашаем Вас разделить радость особенного для нас события — нашей свадьбы!

            +AnimatedShow.o-about__time
                +Title('2').o-about__time-title До дня торжества
                .o-about__time-items
                    .o-about__time-item
                        .o-about__time-count.js-about-time__day 0
                        .o-about__time-desc.js-about-label__day день
                    .o-about__time-item
                        .o-about__time-count.js-about-time__hour 0
                        .o-about__time-desc.js-about-label__hour часа
                    .o-about__time-item
                        .o-about__time-count.js-about-time__minute 0
                        .o-about__time-desc.js-about-label__minute минут

            
