mixin Dress()
    .o-dress
        .o-dress__vector 
            img(src="/img/vectors/locate-btm.svg")
        .o-dress__text
            +AnimatedShow
                +Title('1').o-dress__title Дресс-код
            +AnimatedShow
                .o-dress__desc Нам будет очень приятно, если <br>Вы поддержите цветовую <br>гамму торжества
        .o-dress__colors.o-dress__colors--reveal.js-animatedShow
            .o-dress__color
                img(src="/img/dress/color-1.png")
            .o-dress__color
                img(src="/img/dress/color-2.png")
            .o-dress__color
                img(src="/img/dress/color-3.png")
            .o-dress__color
                img(src="/img/dress/color-4.png")
            .o-dress__color
                img(src="/img/dress/color-5.png")
            .o-dress__color
                img(src="/img/dress/color-6.png")