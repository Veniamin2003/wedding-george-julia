mixin Fscreen()
    .o-fscreen
        .o-fscreen__blur
        .o-fscreen__label wedding day
        .o-fscreen__picture
            img(src="/img/fscreen.webp")
            .o-fscreen__vector 
                img(src="/img/vectors/fscreen-bt.svg")
        .o-fscreen__text
            +Title('1').o-fscreen__title Георгий и Юлия
            +Title('2').o-fscreen__date 20 июня 2026, 11:00
        

